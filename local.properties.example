#  ⚠  DO NOT PUT REAL KEYS IN THIS FILE  ⚠
#
#  This is a TRACKED template. Real keys belong in `local.properties`
#  (no `.example`), which is gitignored and is the only file the build reads.
#  The build will refuse to run if it finds real keys here.
#
#  Android Studio creates `local.properties` for you with `sdk.dir` already
#  filled in — just add the key lines below it.

# Path to your Android SDK (Android Studio fills this in automatically)
sdk.dir=/Users/you/Library/Android/sdk

# https://www.exchangerate-api.com/  (v6 REST key)
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key

# Google AI Studio key used for the Gemini OCR receipt parser
GEMINI_API_KEY=your_gemini_api_key

# Google Maps Platform key (Geocoding API) used for the GPS address field.
# Enable "Geocoding API" in Google Cloud Console for the project that owns it.
# Note: Geocoding API calls are billed per request and cannot be restricted by
# package name, so keep this key separate from any Android-restricted key.
MAPS_API_KEY=your_maps_api_key

# OAuth 2.0 *Web application* client ID used for Google sign-in.
# Google Cloud Console -> Credentials -> Create credentials -> OAuth client ID
# -> Web application. You also need an Android client ID registered with your
# package name (com.cashmemer) and signing SHA-1, but only the Web one goes here.
# Leave blank to run the app without sign-in.
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
