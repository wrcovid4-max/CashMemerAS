<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="barcode"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_barcode"
        android:shortcutShortLabel="@string/barcode_scan"
        android:shortcutLongLabel="@string/barcode_scan">
        <intent
            android:action="com.cashmemer.action.SHORTCUT_BARCODE"
            android:targetPackage="com.cashmemer"
            android:targetClass="com.cashmemer.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="history"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_history"
