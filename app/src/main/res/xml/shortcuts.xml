            android:action="com.cashmemer.action.SHORTCUT_HISTORY"
            android:targetPackage="com.cashmemer"
            android:targetClass="com.cashmemer.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="dashboard"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_dashboard"
        android:shortcutShortLabel="@string/tab_dashboard"
        android:shortcutLongLabel="@string/tab_dashboard">
        <intent
            android:action="com.cashmemer.action.SHORTCUT_DASHBOARD"
            android:targetPackage="com.cashmemer"
